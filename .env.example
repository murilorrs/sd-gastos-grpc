# Copie para .env e preencha. O .env fica fora do git.
GEMINI_API_KEY=paste-your-key-here

# Opcionais. Liste o que sua conta enxerga com: python client/nlu.py --models
# Modelos são aposentados sem aviso — o gemini-2.5-flash já não atende contas novas.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
