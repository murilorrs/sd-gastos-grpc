[Unit]
Description=Microservice B - gRPC expense server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/sd-gastos-grpc/server
# Credenciais do Cloud SQL (PGHOST, PGUSER, PGPASSWORD...), copiadas pelo
# deploy.sh. O "-" torna o arquivo opcional: sem ele, o servidor usa o SQLite
# do --database abaixo.
EnvironmentFile=-/opt/sd-gastos-grpc/server.env
ExecStart=/opt/sd-gastos-grpc/.venv/bin/python server.py --database /opt/sd-gastos-grpc/expenses.db
Restart=always
RestartSec=3
# Roda como root para não depender de qual usuário o gcloud criou na VM.
# Num sistema de verdade isto seria um usuário dedicado sem shell.
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
